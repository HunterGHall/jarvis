{
  "name": "jarvis",
  "productName": "jarvis",
  "version": "0.1.6",
  "description": "J.A.R.V.I.S. desktop app",
  "main": "main.js",
  "author": "Hunter Hall",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "prepare:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-backend.ps1",
    "build:setup": "npm run prepare:backend && electron-builder --win nsis --config setup.config.json"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.hunterhall.jarvis",
    "productName": "jarvis",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "jarvis-logo.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "jarvis.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
